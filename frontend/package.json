{
  "name": "friday",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "stop:desktop": "powershell -ExecutionPolicy Bypass -File ../scripts/stop-friday.ps1",
